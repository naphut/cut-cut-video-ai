# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.ses

# Environment variables & sensitive configs (API keys)
.env
.env.*
!.env.example
config.json
!config.example.json

# Large media, temp files, and rendered outputs
temp/
output/
*.mp4
*.mkv
*.mov
*.avi
*.flv
*.wmv
temp_test.mp3

# Storage generated caches
storage/generated/*
!storage/generated/.gitkeep

# Models & large checkpoints
models/*
!models/.gitkeep

# Builds, packages & executables
dist/
build/
Output/
output/
*.exe
*.dmg
*.pkg
Video AI.app/
scratch/
**/node_modules/
**/dist/
**/build/
.turbo/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE / Editor files
.idea/
.vscode/
*.swp
*.swo
